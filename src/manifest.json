{
  "manifest_version": 3,
  "name": "AEGIS: Universal AI Privacy Shield",
  "version": "5.5.0",
  "description": "Open-source endpoint DLP. Intercepts and redacts PII before it reaches AI platforms. 100% local.",
  "permissions": ["activeTab", "storage", "clipboardRead"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end" }],
  "action": { "default_popup": "popup.html" },
  "options_page": "options.html",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
