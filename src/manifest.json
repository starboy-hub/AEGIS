{
  "manifest_version": 3,
  "name": "AEGIS: Universal AI Privacy Shield",
  "version": "9.7.0",
  "description": "Open-source endpoint DLP. Intercepts and redacts PII before it reaches AI platforms. 100% local.",
  "permissions": ["activeTab", "storage", "contextMenus", "offscreen", "sidePanel"],
  "side_panel": {
    "default_path": "popup.html"
  },
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["aegis-shared.js", "aegis-vault.js", "fake-data.js", "detection-engine.js", "sentinel-engine.js", "injection-engine.js", "webmail-profile.js", "semantic-engine.js", "content.js"], "run_at": "document_end",
   "all_frames": true }],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
