{
  "root": true,
  "env": {
    "browser": true,
    "worker": true,
    "node": true,
    "es2022": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "globals": {
    "chrome": "readonly",
    "AEGIS": "readonly",
    "AEGIS_ENGINE": "readonly",
    "AEGIS_FAKE": "readonly",
    "AEGIS_VAULT": "readonly",
    "AEGIS_SENTINEL": "readonly",
    "AEGIS_INJECTION": "readonly",
    "AEGIS_WEBMAIL": "readonly",
    "AEGIS_REALITY": "readonly",
    "AEGIS_SIGNING": "readonly",
    "AEGIS_THREATS": "readonly",
    "AEGIS_SEMANTIC": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "rules": {
    "no-console": "off",
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": true
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "semi": [
      "error",
      "always"
    ],
    "quotes": [
      "warn",
      "single"
    ]
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "coverage/"
  ],
  "overrides": [
    {
      "files": [
        "src/background/offscreen.js"
      ],
      "parserOptions": {
        "sourceType": "module"
      }
    }
  ]
}
