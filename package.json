    "data-protection"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.44.1",
    "@types/jest": "^30.0.0",
    "eslint": "^8.57.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2"
  }
}
