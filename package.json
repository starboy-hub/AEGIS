{
  "name": "aegis-extension",
  "version": "9.4.0",
  "description": "AEGIS - local-first guardian against AI-era threats: data-leak shielding, scam detection, injection firewall, media provenance. 100% local.",
  "main": "build.js",
  "scripts": {
    "build": "node build.js",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
    "test": "jest --coverage",
    "test:e2e": "npm run build && playwright test",
    "benchmark": "node evaluation/benchmark.js --compare",
    "pack": "node scripts/pack.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --reporters=default --reporters=html",
    "eval:semantic": "node evaluation/capture-scores.js && node evaluation/semantic-eval.js"
  },
  "keywords": [
    "chrome-extension",
    "privacy",
    "pii",
    "ai-security",
    "data-protection"
  ],
  "author": "",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.44.1",
    "@types/jest": "^30.0.0",
    "eslint": "^8.57.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0"
  }
}
